[Desktop Entry]
Type=Application
Name=Blurt
Comment=Talk anywhere you can type
Icon=dev.blurt.Blurt
Exec=blurt
Terminal=false
StartupNotify=true
Categories=Utility;Accessibility;
Keywords=voice;dictation;speech;transcribe;dictate;typing;
Actions=settings;history;

[Desktop Action settings]
Name=Settings
Exec=blurt settings

[Desktop Action history]
Name=Show History
Exec=blurt history --window
